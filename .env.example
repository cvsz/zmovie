# zMovie runtime
ZMOVIE_HOST=0.0.0.0
ZMOVIE_PORT=8080
ZMOVIE_DB_PATH=data/zmovie.db
ZMOVIE_MEDIA_ROOT=data/media
ZMOVIE_EXPORT_ROOT=data/exports

# Authentication (recommended for any network-accessible deployment)
ZMOVIE_AUTH_ENABLED=true
ZMOVIE_SECRET_KEY=replace-with-at-least-32-random-bytes
ZMOVIE_ADMIN_USER=admin
ZMOVIE_ADMIN_PASSWORD=replace-with-a-long-random-password
ZMOVIE_TOKEN_TTL=86400

# Optional browser origins, comma separated. Same-origin needs no value.
ZMOVIE_CORS_ORIGINS=

# Native ComfyUI provider (recommended for self-hosted local inference)
# In ComfyUI export the workflow in API format, copy that JSON to the zMovie
# host, then set the path here. ComfyUI normally listens on port 8188.
ZMOVIE_COMFYUI_URL=http://127.0.0.1:8188
ZMOVIE_COMFYUI_WORKFLOW=
ZMOVIE_COMFYUI_TOKEN=
ZMOVIE_COMFYUI_HEADERS_JSON=
ZMOVIE_COMFYUI_TIMEOUT=3600
ZMOVIE_COMFYUI_POLL_INTERVAL=2
ZMOVIE_COMFYUI_FPS=16
# Wan-family workflows commonly use a frame count shaped as 4n+1.
ZMOVIE_COMFYUI_FRAME_MULTIPLE=4
ZMOVIE_COMFYUI_FRAME_OFFSET=1
ZMOVIE_COMFYUI_FILENAME_PREFIX=zmovie
# Optional fixed values. Leave blank to derive from the zMovie shot/project.
ZMOVIE_COMFYUI_SEED=
ZMOVIE_COMFYUI_WIDTH=
ZMOVIE_COMFYUI_HEIGHT=
# Optional comma-separated API-workflow node IDs when placeholders are not used.
ZMOVIE_COMFYUI_POSITIVE_NODE_IDS=
ZMOVIE_COMFYUI_NEGATIVE_NODE_IDS=
ZMOVIE_COMFYUI_SEED_NODE_IDS=
ZMOVIE_COMFYUI_FRAMES_NODE_IDS=
ZMOVIE_COMFYUI_SIZE_NODE_IDS=

# Optional generic real-video render gateway.
# Receives JSON containing prompt, negative_prompt, job_id, project_id, shot_id,
# duration_seconds and aspect_ratio.
ZMOVIE_PROVIDER_WEBHOOK=
ZMOVIE_PROVIDER_TOKEN=

# Optional audit/object paths
ZMOVIE_AUDIT_PATH=data/audit.jsonl
ZMOVIE_OBJECT_ROOT=data/objects
