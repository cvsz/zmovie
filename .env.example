# zMovie runtime
ZMOVIE_HOST=0.0.0.0
ZMOVIE_PORT=8080
ZMOVIE_DB_PATH=data/zmovie.db
ZMOVIE_MEDIA_ROOT=data/media
ZMOVIE_EXPORT_ROOT=data/exports

# Authentication (recommended for any network-accessible deployment)
ZMOVIE_AUTH_ENABLED=true
ZMOVIE_SECRET_KEY=replace-with-at-least-32-random-bytes
ZMOVIE_ADMIN_USER=admin
ZMOVIE_ADMIN_PASSWORD=replace-with-a-long-random-password
ZMOVIE_TOKEN_TTL=86400

# Optional browser origins, comma separated. Same-origin needs no value.
ZMOVIE_CORS_ORIGINS=

# Optional real video render gateway
# Receives JSON containing prompt, negative_prompt, job_id, project_id, shot_id,
# duration_seconds and aspect_ratio.
ZMOVIE_PROVIDER_WEBHOOK=
ZMOVIE_PROVIDER_TOKEN=

# Optional audit/object paths
ZMOVIE_AUDIT_PATH=data/audit.jsonl
ZMOVIE_OBJECT_ROOT=data/objects
