# ZeaZ License Server — environment template (NO real secrets here).
# Copy to the restricted service env file (0600, root-owned) and fill in.
#
#   /etc/zmovie-cinema/license-admin.env   -> LICENSE_ADMIN_TOKEN
#   /etc/zmovie-cinema/license-server.env  -> LICENSE_SEED_KEYS (+ overrides)

# Admin token for /v1/admin/* and /v1/leases/* (hex, 64 chars). REQUIRED.
LICENSE_ADMIN_TOKEN=

# Comma-separated license keys to pre-register (secret; REQUIRED in prod).
LICENSE_SEED_KEYS=

# Optional overrides (defaults shown).
#LICENSE_KEYS_DIR=/home/cvsz/.config/zeaz
#LICENSE_SIGNING_KID=e58bc8616e5d12cf
#LICENSE_RATE_LIMIT_MAX=20
#LICENSE_RATE_LIMIT_WINDOW=60
