# WordPress target
WP_PATH=/var/www/zmovie-cinema
WP_URL=https://cinema.example.com
WP_TITLE=ZeaZ Cinema
WP_ADMIN_USER=zeazadmin
WP_ADMIN_EMAIL=admin@example.com
WP_ADMIN_PASSWORD=change-me-with-secret-manager
WP_LOCALE=th
WP_VERSION=latest

# Database (existing MySQL/MariaDB service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zmovie_cinema
DB_USER=zmovie_cinema
DB_PASSWORD=change-me-with-secret-manager
DB_PREFIX=wp_

# Optional: automatically create DB/user using privileged MySQL credentials.
# Leave disabled when your DB is provisioned separately.
DB_AUTO_CREATE=false
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Installer behavior
INSTALL_PLUGIN=true
INSTALL_THEME=true
ACTIVATE_THEME=true
CREATE_CINEMA_PAGES=true
VERIFY_CHECKSUMS=true
FORCE_CORE_DOWNLOAD=false

# First-party ZeaZ License runtime environment.
# Keep ZEAZ_LICENSE_KEY in your host secret manager; never commit a real key.
ZEAZ_LICENSE_API=https://license.example.com
ZEAZ_LICENSE_ORIGIN=https://cinema.example.com
ZEAZ_LICENSE_KEY=
ZEAZ_LICENSE_PUBLIC_KEY=
