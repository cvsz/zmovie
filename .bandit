# zMovie bandit configuration
#
# กฎต่อไปนี้ถูกยกเว้นอย่างตั้งใจหลังจากตรวจสอบความมั่นคงปลอดภัยแล้ว
# (แต่ละรายการเป็นพฤติกรรมโดยเจตนา ไม่ใช่ช่องโหว่จริง):
#
#  B101  assert ใช้ตรวจสอบค่าคงที่/เงื่อนไขภายในโค้ดเท่านั้น ไม่ใช้ตรวจสอบความปลอดภัย
#  B311  random ใช้สร้างโปรอมต์และตัวอย่างทั่วไป ไม่ใช้เข้ารหัสหรือสร้างโทเค็นความปลอดภัย
#  B404  subprocess เรียก ffmpeg / espeak-ng เท่านั้น คำสั่งสร้างจากค่าที่ควบคุมได้ภายในระบบ
#  B603  同上 คำสั่งถูกสร้างเป็นลิสต์อาร์กิวเมนต์ (ไม่ใช้ shell=True)
#  B110  try/except/pass ใช้กลั่นกรองข้อผิดพลาดเมื่อค้นหาข้อมูลผู้ให้บริการ
#  B112  try/except/continue ใช้ข้ามระเบียนที่อ่านไม่ได้ในรายการ
#  B105  privacy.py ข้อความ "[REDACTED]" คือตัวแทนการซ่อนรหัสลับ ไม่ใช่รหัสผ่านจริง
#  B324  MD5 ใช้สร้าง fingerprint เพลงใน manifest เท่านั้น ไม่ใช้ด้านความมั่นคงปลอดภัย
#  B104  security_audit.py รายการ ["localhost","127.0.0.1","0.0.0.0"] ใช้ตรวจจับสตริงโดเมน ไม่ใช่การ bind ทุกเครือข่าย
exclude_dirs: [tests, .venv, __pycache__]
skips: [B101, B110, B112, B311, B404, B603, B105, B324, B104]
